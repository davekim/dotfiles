[color]
  ui = auto
[alias]
  st = status
  br = branch
  co = checkout
  ci = commit
  aa = add --all
  staged = diff --staged
  ls = log --graph --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --all
[core]
  editor = nvim
[user]
  name = davekim
  email = davekim@users.noreply.github.com
[credential]
  helper = osxkeychain
[url "git@github.com:"]
  insteadOf = https://github.com/
[push]
  autoSetupRemote = true
