[color]
	ui = auto
[alias]
	st = status
	br = branch
	co = checkout
	ci = commit
	aa = add --all
	staged = diff --staged
	ls = log --graph --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --all
[core]
	editor = nvim
[credential]
	helper = osxkeychain
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[include]
	path = ~/.gitconfig.local
